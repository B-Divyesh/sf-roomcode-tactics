{
  "name": "roomcode-tactics",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "dev": "vite --host 127.0.0.1 --port 5173",
    "dev:service": "tsx service/src/index.ts",
    "build": "npm run build:service && vite build",
    "build:service": "tsc -p service/tsconfig.json",
    "check": "tsc --noEmit && tsc -p service/tsconfig.json --noEmit",
    "pretest": "node scripts/clean-test-data.mjs",
    "test": "playwright test",
    "test:service": "node --import tsx --test service/test/*.test.ts",
    "test:claim:durable-room-state": "node --import tsx --test --test-name-pattern=@claim:durable-room-state service/test/game.test.ts",
    "test:claim:idempotent-moves": "node --import tsx --test --test-name-pattern=@claim:idempotent-moves service/test/game.test.ts",
    "test:claim:opaque-room-pass": "node --import tsx --test --test-name-pattern=@claim:opaque-room-pass service/test/game.test.ts",
    "test:claim:request-limits": "node --import tsx --test --test-name-pattern=@claim:request-limits service/test/game.test.ts",
    "test:claim:room-expiry": "node --import tsx --test --test-name-pattern=@claim:room-expiry service/test/game.test.ts",
    "test:claim:seeded-map-content": "node --import tsx --test --test-name-pattern=@claim:seeded-map-content service/test/game.test.ts",
    "test:claim:scoring-draw": "node --import tsx --test --test-name-pattern=@claim:scoring-draw service/test/game.test.ts",
    "test:all": "npm run check && npm run test:service && npm test",
    "verify:live": "node scripts/verify-live.mjs",
    "preview": "vite preview --host 127.0.0.1 --port 4173"
  },
  "dependencies": {
    "@hono/node-server": "^1.14.4",
    "hono": "^4.7.2"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.10.2",
    "@playwright/test": "1.58.2",
    "@types/node": "^22.13.10",
    "tsx": "^4.19.3",
    "typescript": "^5.7.3",
    "vite": "^6.2.1"
  }
}
